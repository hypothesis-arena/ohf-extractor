{
  "type": "object",
  "properties": {
    "schema": {
      "const": "call@1"
    },
    "record_kind": {
      "enum": [
        "model_call",
        "synthetic_fixture"
      ]
    },
    "role": {
      "enum": [
        "judge",
        "extractor",
        "critic"
      ]
    },
    "context": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,255}$"
            },
            "plan_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "cell_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,255}$"
            },
            "cards": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,255}$"
                  },
                  "content_hash": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "id",
                  "content_hash"
                ],
                "additionalProperties": false
              },
              "minItems": 2,
              "maxItems": 2
            },
            "question": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,255}$"
            },
            "hint": {
              "type": "boolean"
            },
            "order": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,255}$"
              },
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true
            },
            "receipt": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,255}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "kind": {
                  "const": "scrubbed-agent-evidence@1"
                }
              },
              "required": [
                "id",
                "sha256",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "run_id",
            "plan_sha256",
            "cell_key",
            "cards",
            "question",
            "hint",
            "order",
            "receipt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "card_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,255}$"
            },
            "version": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,255}$"
            },
            "stage": {
              "enum": [
                "extraction",
                "critique"
              ]
            },
            "receipt": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,255}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "kind": {
                  "const": "scrubbed-agent-evidence@1"
                }
              },
              "required": [
                "id",
                "sha256",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "card_id",
            "version",
            "stage",
            "receipt"
          ],
          "additionalProperties": false
        }
      ]
    },
    "model": {
      "type": "object",
      "properties": {
        "requested": {
          "type": "string"
        },
        "reported": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "requested",
        "reported"
      ],
      "additionalProperties": false
    },
    "effort": {
      "type": [
        "string",
        "null"
      ]
    },
    "timing": {
      "type": "object",
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "started_at",
        "finished_at"
      ],
      "additionalProperties": false
    },
    "usage": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "output_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "reasoning_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "input_tokens",
            "output_tokens",
            "reasoning_tokens"
          ],
          "additionalProperties": false
        }
      ]
    },
    "input": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string"
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*(?:\\.[A-Za-z0-9_-]+)?$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "sha256",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "projections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^https://[^\\s]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "licence": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "open",
                      "restricted",
                      "unknown"
                    ]
                  },
                  "identifier": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "evidence": {
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "identifier",
                  "evidence"
                ],
                "additionalProperties": false
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "ref",
              "sha256",
              "licence"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "licence": {
                      "properties": {
                        "status": {
                          "const": "open"
                        }
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "licence": {
                      "properties": {
                        "identifier": {
                          "enum": [
                            "CC0-1.0",
                            "CC-BY-4.0",
                            "CC-BY-SA-4.0",
                            "SOURCE-PUBLIC-DOMAIN",
                            "CC-BY-3.0",
                            "CC-BY-2.5",
                            "CC-BY-2.0",
                            "CC-BY-1.0"
                          ]
                        },
                        "evidence": {
                          "minLength": 1
                        }
                      }
                    }
                  }
                },
                "else": {
                  "not": {
                    "required": [
                      "text"
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "required": [
        "prompt",
        "instructions",
        "projections",
        "materials"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "response_file": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "first_write_proven": {
                  "type": "boolean"
                }
              },
              "required": [
                "text",
                "sha256",
                "first_write_proven"
              ],
              "additionalProperties": false
            }
          ]
        },
        "final_message": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "completed",
            "invalid",
            "error",
            "refusal",
            "interrupted"
          ]
        }
      },
      "required": [
        "response_file",
        "final_message",
        "status"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "session_events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "checker_output": {
          "type": "string"
        },
        "representation": {
          "const": "scrubbed-copy-not-source-bytes"
        }
      },
      "required": [
        "session_events",
        "stdout",
        "stderr",
        "checker_output",
        "representation"
      ],
      "additionalProperties": false
    },
    "availability_notes": {
      "type": "array",
      "items": {
        "enum": [
          "usage_unavailable",
          "synthetic_no_inference",
          "material_text_withheld_licence",
          "reported_model_unavailable",
          "response_file_unavailable",
          "final_message_unavailable",
          "session_log_unavailable",
          "checker_output_unavailable",
          "first_response_unproven",
          "interrupted_before_response"
        ]
      },
      "uniqueItems": true
    },
    "redaction": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "synthetic_no_secrets",
            "scrubbed"
          ]
        },
        "policy_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "policy_sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "record_kind",
    "role",
    "context",
    "model",
    "effort",
    "timing",
    "usage",
    "input",
    "output",
    "evidence",
    "availability_notes",
    "redaction"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hypothesis-arena:call:1",
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "judge"
          }
        }
      },
      "then": {
        "properties": {
          "context": {
            "type": "object",
            "properties": {
              "run_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,255}$"
              },
              "plan_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "cell_key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,255}$"
              },
              "cards": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,255}$"
                    },
                    "content_hash": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "id",
                    "content_hash"
                  ],
                  "additionalProperties": false
                },
                "minItems": 2,
                "maxItems": 2
              },
              "question": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,255}$"
              },
              "hint": {
                "type": "boolean"
              },
              "order": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,255}$"
                },
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": true
              },
              "receipt": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,255}$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "kind": {
                    "const": "scrubbed-agent-evidence@1"
                  }
                },
                "required": [
                  "id",
                  "sha256",
                  "kind"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "run_id",
              "plan_sha256",
              "cell_key",
              "cards",
              "question",
              "hint",
              "order",
              "receipt"
            ],
            "additionalProperties": false
          }
        }
      },
      "else": {
        "properties": {
          "context": {
            "type": "object",
            "properties": {
              "card_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,255}$"
              },
              "version": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,255}$"
              },
              "stage": {
                "enum": [
                  "extraction",
                  "critique"
                ]
              },
              "receipt": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,255}$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "kind": {
                    "const": "scrubbed-agent-evidence@1"
                  }
                },
                "required": [
                  "id",
                  "sha256",
                  "kind"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "card_id",
              "version",
              "stage",
              "receipt"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "extractor"
          }
        }
      },
      "then": {
        "properties": {
          "context": {
            "properties": {
              "stage": {
                "const": "extraction"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "critic"
          }
        }
      },
      "then": {
        "properties": {
          "context": {
            "properties": {
              "stage": {
                "const": "critique"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "model_call"
          }
        }
      },
      "then": {
        "properties": {
          "redaction": {
            "properties": {
              "state": {
                "const": "scrubbed"
              },
              "policy_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  ]
}
