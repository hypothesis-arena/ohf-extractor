nths", "expressionEvaluationBy": "mRNA", "statisticalMethod": null, "controlCohortSize": null, "experimentCohortSize": null, "sex": "male", "comment": ""}], "interventionToGeneImprovesVitalProcesses": [{"id": "119", "geneIntervention": "gene knockout", "result": "improvement", "resultCode": 1, "vitalProcess": "cardiovascular system", "vitalProcessId": "4", "modelOrganism": "mouse", "organismLine": "C57BL/6J", "age": "0 days", "genotype": "n/-", "sex": "all", "doi": "10.1089/rej.2007.0587", "pmid": "", "comment": "The authors investigated mice, heterozygous in the ELN gene first exon deletion. At 25 monats of age, these mice show signs of the alternative aging in the cardiovascular system. It means, that these mice have some specific age-related changes, and, at the same time, they do not have some changes, which are normal for the old wild type mice. \r\nFor example, the aged ELN mutants have impairment of the vasorelaxation (which is not observed in normal aged mice), and, at the same time, do not show a typical impairment of the vasoconstriction. The normal age-related arterial thicening was not observed in the ELN-deficient mice.\r\nMutant mice live the normal lifespan, which suggests that negative and positive differences counterbalance one another in these animals.", "interventionImproves": [{"id": "4", "name": "cardiovascular system"}], "interventionDeteriorates": []}], "proteinRegulatesOtherGenes": [{"proteinActivity": "upregulates, mechanism not established", "regulationType": "mRNA level ", "doi": "10.1161/01.ATV.0000168412.50855.9f", "pmid": "", "comment": "Elastin-derived peptides upregulate IL2 gene in human lymphocytes at the both mRNA and protein levels via activation of elastin binding protein. The elastin-derived peptides were added to the lymphocytes in concentration comparable to the blood of healthy people. ", "regulatedGene": {"id": 46, "symbol": "IL2", "name": "interleukin 2", "ncbiId": 3558}}, {"proteinActivity": "upregulates, mechanism not established", "regulationType": "mRNA level ", "doi": "10.1161/01.ATV.0000168412.50855.9f", "pmid": "", "comment": "Elastin-derived peptides upregulate IFNG gene in human lymphocytes at the both mRNA and protein levels via activation of elastin binding protein. The elastin-derived peptides were added to the lymphocytes in concentration comparable to the blood of healthy people. ", "regulatedGene": {"id": 329, "symbol": "IFNG", "name": "interferon gamma", "ncbiId": 3458}}, {"proteinActivity": "upregulates, mechanism not established", "regulationType": "protein level", "doi": "10.1161/01.ATV.0000168412.50855.9f", "pmid": "", "comment": "Elastin-derived peptides upregulate IL2 gene in human lymphocytes at the both mRNA and protein levels via activation of elastin binding protein. The elastin-derived peptides were added to the lymphocytes in concentration comparable to the blood of healthy people. ", "regulatedGene": {"id": 46, "symbol": "IL2", "name": "interleukin 2", "ncbiId": 3558}}, {"proteinActivity": "upregulates, mechanism not established", "regulationType": "protein level", "doi": "10.1161/01.ATV.0000168412.50855.9f", "pmid": "", "comment": "Elastin-derived peptides upregulate IFNG gene in human lymphocytes at the both mRNA and protein levels via activation of elastin binding protein. The elastin-derived peptides were added to the lymphocytes in concentration comparable to the blood of healthy people. ", "regulatedGene": {"id": 329, "symbol": "IFNG", "name": "interferon gamma", "ncbiId": 3458}}], "additionalEvidences": []}, "commentEvolution": "ELN(elastin) is one of the two components of elastic fibers. ELN belongs to extracellular matrix proteins family.  Extracellular matrix appeared in metazoa and was a key mediator of metazoan multi-cellularity [10.1091/mbc.e10-03-0251]. Unlike many matrix proteins, elastin appeared relatively late at the divergence of jawed and jawless fishes. It presents in all species from sharks to humans, but absent at least as a vascular protein from lampreys, hagfish and other lower chordates and invertebrates. Elastin has a low complexity, highly nonpolar and highly repetitive sequence, with the conservation of an unusual ‘style’ of sequence but an apparently relaxed requirement for precise sequence conservation, even between closely related species [10.1007/978-3-642-36002-2_4]. ", "proteinDescriptionUniProt": "THIRD-PARTY TEXT, removed from the fixture", "descriptionNCBI": "THIRD-PARTY TEXT, removed from the fixture", "proteinDescriptionOpenGenes": "Elastin is a key extracellular matrix protein that is critical to the elasticity and resilience of many vertebrate tissues including large arteries, lung, ligament, tendon, skin, and elastic cartilage [10.1016/S0065-3233(05)70013-9].", "humanProteinAtlas": "THIRD-PARTY TEXT, removed from the fixture", "source": ["calorie_restriction", "GeneAge"]}